// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Staff {
  id               String @id @default(cuid())
  seqnum           Int @default(0)
  name             String
  designation      String
  qualification    String
  experience       String
  area_of_int      String
  email            String @unique
  contact          String?
  photo            String?
  homepage_url     String?
  profile_pdf      String?
  address          String?
  timetables       Staff_Timetable[]
  publications     Staff_Publications[]
  books            Staff_Books[]
  events           Staff_Events[]
  patents          Staff_Patents[]
  grants           Staff_Grants[]
  achievements     Staff_Achievements[]
  teachings        Staff_Teachings[]
  projects         Staff_Projects[]
}

model Staff_Teachings {
  id               String @id @default(cuid())
  staff_email      String
  academic_year    String
  semester         String
  subject_code     String
  course_url       String?
  staff            Staff @relation(fields: [staff_email], references: [email])
}

model Staff_Timetable{
  id               String @id @default(cuid())
  staff_email      String
  academic_year    String
  semester         String
  tt_softcopy      String
  staff            Staff @relation(fields: [staff_email], references: [email])
}

model Staff_Publications{
  id               String @id @default(cuid())
  staff_email      String
  description      String
  seqnum           Int
  staff            Staff @relation(fields: [staff_email], references: [email])
}

model Staff_Books{
  id               String @id @default(cuid())
  staff_email      String
  description      String
  seqnum           Int
  staff            Staff @relation(fields: [staff_email], references: [email])
}

model Staff_Events{
  id               String @id @default(cuid())
  staff_email      String
  description      String
  seqnum           Int
  staff            Staff @relation(fields: [staff_email], references: [email])
}

model Staff_Patents{
  id               String @id @default(cuid())
  staff_email      String
  description      String
  seqnum           Int
  staff            Staff @relation(fields: [staff_email], references: [email])
}

model Staff_Grants{
  id               String @id @default(cuid())
  staff_email      String
  description      String
  seqnum           Int
  staff            Staff @relation(fields: [staff_email], references: [email])
}

model Staff_Achievements{
  id               String @id @default(cuid())
  staff_email      String
  description      String
  seqnum           Int
  staff            Staff @relation(fields: [staff_email], references: [email])
}

model Staff_Projects{
  id               String @id @default(cuid())
  staff_email      String
  description      String
  seqnum           Int
  staff            Staff @relation(fields: [staff_email], references: [email])
}

model Converse {
  id               String @id @default(cuid())
  seqnum           Int @default(0)
  name             String
  event_dates      String
  faculty_co       String
  student_co       String
  report_url       String?
}

model Evaluation_Scheme{
id               String @id @default(cuid())
seqnum           Int @unique
tee              Int
ca1              Int
ca2              Int
tep              Int
ca3              Int
total            Int
subjects         Subject[]
}

model Subject {
  id               String @id @default(cuid())
  eff              String
  category         String @default("")
  semester         String
  code             String
  syllabus_pdf     String
  name             String
  lpw              Int
  tpw              Int
  ppw              Int
  credit           Int
  esnum            Int
  evaluation_Scheme          Evaluation_Scheme @relation(fields: [esnum], references: [seqnum])
}

model TimeTable {
  id               String @id @default(cuid())
  seqnum           Int @unique
  semester         String
  tt_pdf           String
}

model AcademicCalender {
  id               String @id @default(cuid())
  seqnum           Int @unique
  academic_year    String
  semester         String
  ucd              String
  ac_pdf           String
}


